# Copy this file to .env and replace every placeholder locally.
# Never commit or share the populated .env file.

# Neon PostgreSQL
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Authentication: use a long, random secret (at least 32 characters).
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_EXP_SECONDS=3600
JWT_ISSUER=campaign-intelligence
JWT_AUDIENCE=campaign-intelligence-api

# Option A: one configured admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
ADMIN_ROLE=SYS-ADMIN

# Option B (recommended for multiple approvers): JSON map keyed by lowercase email.
# When set, this map supports separate signed roles and spending authorities.
# AUTH_USERS_JSON={"admin@example.com":{"password":"CHANGE_ME","role":"SYS-ADMIN"},"marketing.director@example.com":{"password":"CHANGE_ME","role":"DIR-MKT"},"store.manager@example.com":{"password":"CHANGE_ME","role":"MGR-STORE"},"ops.manager@example.com":{"password":"CHANGE_ME","role":"OPS-MANAGER"}}

# Frontend / CORS
API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:8501
ENVIRONMENT=development
PORT=8000

# Zilliz Cloud / Milvus
ZILLIZ_ENDPOINT=https://YOUR-ZILLIZ-ENDPOINT
ZILLIZ_TOKEN=REPLACE_WITH_YOUR_ZILLIZ_TOKEN
ZILLIZ_COLLECTION=campaign_intelligence_kb

# Gemini semantic embeddings (must match the existing Zilliz collection dimension)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite

# Optional second account: can submit proposals; cannot approve or activate them.
PROPOSAL_USER_EMAIL=proposal-user@example.com
PROPOSAL_USER_PASSWORD=replace_with_a_strong_unique_password
